PORT=8080
GIN_MODE=debug
DB=postgres://postgres:postgres@localhost:5432/pitchtz?sslmode=disable
# DATABASE_URL is also accepted when DB is not set.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/pitchtz?sslmode=disable
REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002
TRUSTED_PROXIES=
ASSET_BASE_URL=
WAITLIST_RATE_LIMIT_PER_MIN=5
WAITLIST_RATE_LIMIT_BURST=5
ADMIN_LOGIN_RATE_LIMIT_PER_MIN=10
ADMIN_LOGIN_RATE_LIMIT_BURST=10
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=pitchtz-api
JWT_ACCESS_TTL_MINUTES=60
# Set these only for the first production boot, then remove the password.
# BOOTSTRAP_ADMIN_NAME=Your Name
# BOOTSTRAP_ADMIN_EMAIL=you@example.com
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-unique-password
OWNER_LOGIN_RATE_LIMIT_PER_MIN=10
OWNER_LOGIN_RATE_LIMIT_BURST=10
RESEND_API_KEY=
RESEND_FROM_EMAIL=PitchTZ <hello@flutterai.dev>
EMAIL_HERO_URL=https://pitchtz.flutterai.dev/images/pitchtz-twin-pitches-v2.png
OWNER_APP_URL=http://localhost:3002
ADMIN_APP_URL=http://localhost:3001
API_PUBLIC_URL=http://localhost:8080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
ENROLL_RATE_LIMIT_PER_MIN=5
ENROLL_RATE_LIMIT_BURST=5
# Optional: seed one test venue owner (with a demo venue+pitch) on first boot.
# BOOTSTRAP_OWNER_NAME=Test Owner
# BOOTSTRAP_OWNER_EMAIL=owner@example.com
# BOOTSTRAP_OWNER_PASSWORD=replace-with-a-strong-unique-password
